es<!doctype html>
<html lang="es-AR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#173657">
  <meta name="description" content="Casa Tito: autoservicio ferretero con más de 73 años de trayectoria. Encontrá categorías, productos de referencia y consultá por WhatsApp.">
  <title>Casa Tito | Todo empieza con una buena elección</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
  <script>document.documentElement.className += " js";</script>
  <style>
    :root {
      --blue-950: #102943;
      --blue-900: #173657;
      --blue-800: #244a78;
      --blue-100: #e9eef3;
      --red-700: #9b252c;
      --red-600: #b52b32;
      --red-100: #f6e6e6;
      --yellow-500: #d4ad43;
      --yellow-300: #ebd17b;
      --paper: #f7f5f0;
      --paper-2: #efede7;
      --white: #fffdf9;
      --ink: #17222d;
      --muted: #68747b;
      --line: rgba(23,34,45,.14);
      --shadow: 0 18px 45px rgba(16,41,67,.12);
      --radius: 3px;
      --sans: "DM Sans", Arial, sans-serif;
      --display: "Manrope", "DM Sans", Arial, sans-serif;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { margin: 0; color: var(--ink); background: var(--paper); font-family: var(--sans); font-size: 16px; line-height: 1.5; overflow-x: hidden; }
    body.menu-open, body.modal-open { overflow: hidden; }
    a { color: inherit; text-decoration: none; }
    button, input { font: inherit; }
    button { border: 0; cursor: pointer; }
    button:disabled { cursor: not-allowed; opacity: .58; }
    :focus-visible { outline: 3px solid var(--yellow-500); outline-offset: 3px; }
    [hidden] { display: none !important; }
    .shell { width: min(1180px, calc(100% - 56px)); margin-inline: auto; }
    .section { padding: 112px 0; }
    .eyebrow { display: flex; align-items: center; gap: 10px; margin: 0 0 18px; color: var(--red-600); font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
    .eyebrow::before { content: ""; width: 28px; height: 2px; background: var(--yellow-500); }
    .eyebrow--light { color: var(--yellow-300); }
    .eyebrow--light::before { background: var(--yellow-500); }
    .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 52px; margin-bottom: 48px; }
    .section-heading h2 { max-width: 690px; margin: 0; color: var(--blue-900); font: 800 clamp(38px, 5vw, 67px)/.98 var(--display); letter-spacing: -.065em; }
    .section-heading h2 em { color: var(--red-600); font-style: normal; }
    .section-heading__copy { max-width: 380px; color: var(--muted); font-size: 15px; line-height: 1.7; }
    .section-heading__copy p { margin: 0; }
    .button { min-height: 48px; padding: 13px 18px; display: inline-flex; align-items: center; justify-content: center; gap: 10px; border: 1px solid transparent; border-radius: var(--radius); font-size: 12px; font-weight: 700; letter-spacing: .035em; transition: transform .2s ease, background .2s ease, color .2s ease, box-shadow .2s ease; }
    .button:hover { transform: translateY(-2px); box-shadow: 0 9px 18px rgba(16,41,67,.15); }
    .button--yellow { color: var(--blue-950); background: var(--yellow-500); }
    .button--yellow:hover { background: var(--yellow-300); }
    .button--red { color: var(--white); background: var(--red-600); }
    .button--red:hover { background: var(--red-700); }
    .button--outline { color: var(--blue-900); border-color: var(--blue-800); background: transparent; }
    .button--outline:hover { color: var(--white); background: var(--blue-800); }
    .button--ghost-light { color: var(--white); border-color: rgba(255,255,255,.35); background: transparent; }
    .button--ghost-light:hover { border-color: var(--yellow-500); color: var(--yellow-300); background: rgba(255,255,255,.06); }
    .text-link { display: inline-flex; align-items: center; gap: 9px; padding-bottom: 4px; color: var(--blue-800); border-bottom: 1px solid var(--yellow-500); font-size: 13px; font-weight: 700; }
    .text-link:hover { color: var(--red-600); }
    .icon { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; }

    .notice-bar { position: relative; z-index: 40; min-height: 35px; padding: 8px 46px; display: flex; align-items: center; justify-content: center; color: var(--blue-950); background: var(--yellow-500); font-size: 12px; text-align: center; }
    .notice-bar strong { font-weight: 800; }
    .notice-bar button { position: absolute; right: 18px; top: 3px; width: 28px; height: 28px; color: var(--blue-950); background: transparent; font-size: 22px; line-height: 1; }

    .site-header { position: sticky; top: 0; z-index: 30; color: var(--blue-950); background: rgba(247,245,240,.96); border-bottom: 1px solid transparent; backdrop-filter: blur(14px); transition: box-shadow .25s ease, border-color .25s ease; }
    .site-header.is-scrolled { border-color: var(--line); box-shadow: 0 5px 22px rgba(16,41,67,.08); }
    .nav-wrap { min-height: 84px; display: flex; align-items: center; gap: 30px; }
    .brand { display: inline-flex; align-items: center; flex-shrink: 0; }
    .brand svg { display: block; width: 162px; height: auto; }
    .ct-logo__roof-shadow { fill: none; stroke: var(--red-600); stroke-width: 7; stroke-linecap: round; opacity: .16; }
    .ct-logo__roof { fill: none; stroke: var(--red-600); stroke-width: 3; stroke-linecap: round; }
    .ct-logo__wall, .ct-logo__base { fill: none; stroke: var(--blue-900); stroke-width: 2.5; stroke-linecap: round; }
    .ct-logo__text { fill: var(--blue-900); font: 800 25px var(--display); letter-spacing: -.06em; }
    .ct-logo__accent { fill: var(--red-600); }
    .ct-logo__since { fill: var(--blue-800); font: 600 8px var(--sans); letter-spacing: .11em; }
    .desktop-nav { display: flex; align-items: center; gap: clamp(18px, 3vw, 38px); margin-left: auto; }
    .desktop-nav a { position: relative; padding: 30px 0; color: #52606a; font-size: 13px; font-weight: 600; }
    .desktop-nav a::after { content: ""; position: absolute; left: 0; right: 100%; bottom: 22px; height: 2px; background: var(--red-600); transition: right .2s ease; }
    .desktop-nav a:hover { color: var(--red-600); }
    .desktop-nav a:hover::after { right: 0; }
    .nav-actions { display: flex; align-items: center; gap: 11px; margin-left: 3px; }
    .header-search { width: 40px; height: 40px; display: grid; place-items: center; color: var(--blue-900); background: transparent; border-radius: 50%; }
    .header-search:hover { color: var(--white); background: var(--blue-800); }
    .header-search .icon { width: 19px; height: 19px; }
    .nav-whatsapp { min-height: 39px; padding: 10px 13px; color: var(--white); background: var(--red-600); font-size: 11px; }
    .nav-whatsapp:hover { background: var(--red-700); }
    .menu-toggle { display: none; width: 42px; height: 42px; padding: 8px; color: var(--blue-900); background: transparent; }
    .menu-toggle span { display: block; width: 23px; height: 2px; margin: 5px auto; background: currentColor; transition: transform .2s ease, opacity .2s ease; }
    .menu-toggle.is-active span:first-child { transform: translateY(7px) rotate(45deg); }
    .menu-toggle.is-active span:nth-child(2) { opacity: 0; }
    .menu-toggle.is-active span:last-child { transform: translateY(-7px) rotate(-45deg); }
    .mobile-menu { display: none; }

    .hero { position: relative; overflow: hidden; padding: 92px 0 70px; color: var(--white); background: var(--blue-900); }
    .hero::before { content: ""; position: absolute; width: 720px; height: 720px; right: -270px; top: -270px; border: 1px solid rgba(235,209,123,.2); border-radius: 50%; box-shadow: 0 0 0 72px rgba(235,209,123,.045), 0 0 0 145px rgba(235,209,123,.025); }
    .hero::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 140px; background: linear-gradient(transparent, rgba(16,41,67,.22)); pointer-events: none; }
    .hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1.02fr) minmax(390px, .98fr); align-items: center; gap: 8%; }
    .hero-copy { max-width: 650px; }
    .hero-copy .eyebrow { color: var(--yellow-300); }
    .hero-copy h1 { max-width: 690px; margin: 0; font: 800 clamp(53px, 7vw, 98px)/.9 var(--display); letter-spacing: -.08em; }
    .hero-copy h1 em { color: var(--yellow-300); font-style: normal; }
    .hero-lead { max-width: 530px; margin: 27px 0 30px; color: rgba(255,253,249,.78); font-size: 17px; line-height: 1.65; }
    .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 15px; }
    .hero-note { margin: 37px 0 0; color: rgba(255,253,249,.62); font-size: 12px; }
    .hero-note strong { color: var(--yellow-300); }
    .hero-search { margin-top: 42px; padding: 9px; display: flex; align-items: center; gap: 10px; max-width: 600px; background: var(--white); border: 1px solid rgba(255,255,255,.4); box-shadow: 0 16px 30px rgba(0,0,0,.14); }
    .hero-search .icon { flex: 0 0 auto; color: var(--red-600); margin-left: 8px; }
    .hero-search input { min-width: 0; flex: 1; height: 44px; padding: 0 8px; color: var(--ink); background: transparent; border: 0; outline: 0; font-size: 14px; }
    .hero-search input::placeholder { color: #7c878c; }
    .hero-search button { min-height: 44px; padding: 0 16px; color: var(--blue-950); background: var(--yellow-500); font-size: 12px; font-weight: 800; }
    .hero-search button:hover { background: var(--yellow-300); }
    .hero-art-wrap { min-height: 530px; position: relative; display: grid; place-items: center; }
    .hero-art { width: min(100%, 550px); position: relative; overflow: hidden; display: flex; flex-direction: column; align-items: center; padding: 60px 24px 26px; background: #284866; border: 1px solid rgba(255,255,255,.2); box-shadow: 25px 30px 0 rgba(16,41,67,.42); }
    .hero-art::before { content: ""; position: absolute; inset: 0; opacity: .16; background-image: linear-gradient(rgba(255,255,255,.4) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.4) 1px, transparent 1px); background-size: 38px 38px; }
    .hero-art__label { position: absolute; left: 22px; top: 21px; z-index: 1; color: rgba(255,253,249,.74); font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
    .hero-art__stage { position: relative; z-index: 1; width: 100%; display: flex; flex-direction: column; align-items: center; }
    .hero-art__foot { position: relative; z-index: 1; width: 100%; margin-top: 30px; display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; }
    .hero-art__badge { flex: 0 0 auto; width: 115px; height: 115px; padding: 21px 12px; display: grid; place-items: center; color: var(--blue-950); background: var(--yellow-500); border-radius: 50%; text-align: center; transform: rotate(7deg); box-shadow: 8px 8px 0 rgba(16,41,67,.33); }
    .hero-art__badge strong { display: block; font: 800 34px/.9 var(--display); letter-spacing: -.08em; }
    .hero-art__badge span { display: block; margin-top: 8px; font-size: 10px; font-weight: 800; line-height: 1.1; text-transform: uppercase; }
    .hero-art__caption { max-width: 190px; color: rgba(255,253,249,.75); font-size: 12px; line-height: 1.35; }

    /* ===== Casita de Casa Tito: ventana que se abre ===== */
    .casita { position: relative; width: 100%; max-width: 440px; aspect-ratio: 400 / 270; cursor: pointer; -webkit-tap-highlight-color: transparent; }
    .casita__svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
    .ct-h-roof-shadow { fill: none; stroke: var(--red-600); stroke-width: 11; stroke-linecap: round; opacity: .2; }
    .ct-h-roof { fill: none; stroke: var(--red-600); stroke-width: 4.5; stroke-linecap: round; stroke-linejoin: round; }
    .ct-h-wall, .ct-h-base { fill: none; stroke: var(--white); stroke-width: 3.5; stroke-linecap: round; }
    .ct-h-sill { fill: none; stroke: var(--yellow-300); stroke-width: 3; stroke-linecap: round; }
    .ct-h-ground { fill: rgba(8,20,34,.3); }
    .casita__glow { position: absolute; z-index: 1; left: 12%; top: 30%; width: 76%; height: 70%; pointer-events: none; background: radial-gradient(closest-side, rgba(246,224,140,.5), rgba(235,209,123,.16) 58%, rgba(235,209,123,0)); }
    .casita__window { position: absolute; z-index: 2; left: 28%; top: 44.44%; width: 44%; height: 40%; border: 3px solid var(--white); border-radius: 2px; background: #14304f; perspective: 520px; box-shadow: 0 0 0 4px rgba(16,41,67,.35); }
    .casita__reveal { position: absolute; inset: 0; overflow: hidden; }
    .casita__reveal::after { content: ""; position: absolute; inset: 0; pointer-events: none; box-shadow: inset 0 9px 16px rgba(8,20,34,.55), inset 7px 0 12px rgba(8,20,34,.32), inset -7px 0 12px rgba(8,20,34,.32); }
    .casita__interior { display: block; width: 100%; height: 100%; transform-origin: 50% 55%; }
    .casita__leaf { position: absolute; top: 0; bottom: 0; width: 50%; box-sizing: border-box; border: 2px solid var(--white); will-change: transform; -webkit-backface-visibility: hidden; backface-visibility: hidden;
      background:
        linear-gradient(rgba(255,253,249,.85), rgba(255,253,249,.85)) 0 50% / 100% 2px no-repeat,
        linear-gradient(115deg, transparent 26%, rgba(255,255,255,.2) 38%, transparent 50%),
        linear-gradient(160deg, #2b5584, #173657); }
    .casita__leaf::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: #0b1c2e; opacity: 0; }
    .casita__leaf--l { left: 0; transform-origin: 0 50%; border-right-width: 1px; }
    .casita__leaf--r { right: 0; transform-origin: 100% 50%; border-left-width: 1px; }
    .casita__cta { position: relative; z-index: 1; margin-top: 22px; min-height: 52px; padding: 14px 26px; font-size: 14px; letter-spacing: .02em; box-shadow: 0 10px 24px rgba(8,20,34,.28); }
    .casita__cta .icon { width: 18px; height: 18px; flex: 0 0 auto; transition: transform .25s ease; }
    .casita__cta:hover .icon { transform: translateX(4px); }

    /* Estado inicial (solo con JS): la casita se dibuja y la ventana está cerrada */
    .js .casita:not(.is-open) .c-draw { stroke-dasharray: 1; stroke-dashoffset: 1.02; }
    .js .casita:not(.is-open) .ct-h-ground { opacity: 0; }
    .js .casita:not(.is-open) .casita__window { opacity: 0; transform: scale(.97); }
    .js .casita:not(.is-open) .casita__glow { opacity: 0; }
    .js .casita:not(.is-open) .casita__interior { transform: scale(1.16); }
    .js .casita:not(.is-open) + .casita__cta { opacity: 0; visibility: hidden; }

    /* Secuencia de apertura (≈2,3 s): líneas → marco → hojas → luz y profundidad → invitación */
    .casita.is-open .c-draw { stroke-dasharray: 1; stroke-dashoffset: 0; transition: stroke-dashoffset .9s cubic-bezier(.5,0,.2,1); }
    .casita.is-open .ct-h-roof-shadow { transition-delay: .05s; }
    .casita.is-open .ct-h-roof { transition-delay: .1s; }
    .casita.is-open .ct-h-wall { transition-delay: .35s; }
    .casita.is-open .ct-h-base { transition-delay: .55s; }
    .casita.is-open .ct-h-sill { transition-delay: .7s; }
    .casita.is-open .ct-h-ground { transition: opacity 1s ease .4s; }
    .casita.is-open .casita__window { transition: opacity .6s ease .55s, transform .8s cubic-bezier(.2,.7,.2,1) .55s; }
    .casita.is-open .casita__leaf--l { animation: ct-leaf-l 1.5s linear .95s both; }
    .casita.is-open .casita__leaf--r { animation: ct-leaf-r 1.5s linear 1.05s both; }
    .casita.is-open .casita__leaf::after { opacity: .34; transition: opacity 1.3s ease 1s; }
    .casita.is-open .casita__interior { transition: transform 1.9s cubic-bezier(.2,.7,.2,1) .95s; }
    .casita.is-open .casita__glow { transition: opacity 1.5s ease 1.15s; }
    .casita.is-open + .casita__cta { animation: ct-cta-in .8s cubic-bezier(.2,.8,.2,1) 1.5s backwards; }
    @keyframes ct-leaf-l {
      0% { transform: rotateY(0deg); animation-timing-function: cubic-bezier(.3,0,.4,1); }
      12% { transform: rotateY(-3deg); animation-timing-function: cubic-bezier(.35,.05,.15,1); }
      100% { transform: rotateY(-64deg); }
    }
    @keyframes ct-leaf-r {
      0% { transform: rotateY(0deg); animation-timing-function: cubic-bezier(.3,0,.4,1); }
      12% { transform: rotateY(3deg); animation-timing-function: cubic-bezier(.35,.05,.15,1); }
      100% { transform: rotateY(64deg); }
    }
    @keyframes ct-cta-in {
      from { opacity: 0; visibility: hidden; transform: translateY(-24px) scale(.94); }
      to { opacity: 1; visibility: visible; transform: none; }
    }
    /* Sin animación: usuarios que reducen movimiento o que ya la vieron en esta sesión */
    .casita.is-instant, .casita.is-instant * { transition: none !important; animation-duration: 0s !important; animation-delay: 0s !important; }
    .casita.is-instant + .casita__cta { animation: none !important; }
    @media (prefers-reduced-motion: reduce) {
      .casita, .casita * { transition: none !important; animation-duration: 0s !important; animation-delay: 0s !important; }
      .casita + .casita__cta { animation: none !important; }
    }

    .trust-strip { color: var(--white); background: var(--red-600); }
    .trust-grid { min-height: 130px; display: grid; grid-template-columns: repeat(3, 1fr) 1.35fr; align-items: center; gap: 22px; }
    .trust-item { min-height: 46px; padding-left: 18px; display: flex; align-items: center; gap: 12px; border-left: 1px solid rgba(255,253,249,.3); }
    .trust-item:first-child { padding-left: 0; border-left: 0; }
    .trust-item strong { font-size: 14px; line-height: 1.2; }
    .trust-item small { display: block; margin-bottom: 4px; color: var(--yellow-300); font-size: 10px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
    .trust-quote { padding-left: 30px; color: rgba(255,253,249,.9); font: italic 21px/1.25 var(--display); }

    .categories { background: var(--paper); }
    .category-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 13px; }
    .category-card { min-height: 220px; padding: 22px; position: relative; display: flex; flex-direction: column; justify-content: space-between; overflow: hidden; color: var(--white); background: var(--blue-800); text-align: left; border-radius: var(--radius); transition: transform .23s ease, box-shadow .23s ease, background .23s ease; }
    .category-card::after { content: ""; width: 170px; height: 170px; position: absolute; right: -54px; bottom: -72px; border: 1px solid rgba(255,255,255,.18); border-radius: 50%; box-shadow: 0 0 0 26px rgba(255,255,255,.04), 0 0 0 54px rgba(255,255,255,.025); }
    .category-card:nth-child(3n + 1) { background: var(--blue-900); }
    .category-card:nth-child(3n + 2) { background: var(--red-600); }
    .category-card:nth-child(4n) { background: #6b4e32; }
    .category-card:hover { transform: translateY(-5px); box-shadow: var(--shadow); }
    .category-card__top { display: flex; align-items: start; justify-content: space-between; gap: 15px; }
    .category-card__number { color: var(--yellow-300); font-size: 11px; font-weight: 800; letter-spacing: .1em; }
    .category-card__icon { width: 43px; height: 43px; display: grid; place-items: center; color: var(--yellow-300); border: 1px solid rgba(235,209,123,.6); border-radius: 50%; }
    .category-card__icon .icon { width: 22px; height: 22px; }
    .category-card h3 { max-width: 175px; margin: 0; font: 700 23px/1.03 var(--display); letter-spacing: -.045em; }
    .category-card p { max-width: 190px; margin: 7px 0 0; color: rgba(255,253,249,.72); font-size: 12px; line-height: 1.45; }
    .category-card__link { position: absolute; right: 19px; bottom: 19px; color: var(--yellow-300); font-size: 20px; line-height: 1; }

    .catalog { background: var(--paper-2); }
    .catalog-toolbar { margin-bottom: 32px; padding: 14px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px; background: var(--white); border: 1px solid var(--line); }
    .catalog-search { min-width: 240px; flex: 1 1 290px; height: 45px; padding: 0 12px; display: flex; align-items: center; gap: 9px; border-bottom: 2px solid var(--blue-800); }
    .catalog-search .icon { color: var(--red-600); }
    .catalog-search input { width: 100%; height: 100%; min-width: 0; padding: 0; color: var(--ink); border: 0; outline: 0; background: transparent; font-size: 14px; }
    .filter-list { display: flex; flex-wrap: wrap; gap: 7px; }
    .filter-chip { min-height: 37px; padding: 8px 11px; color: var(--blue-800); background: var(--paper); border: 1px solid var(--line); border-radius: 99px; font-size: 11px; font-weight: 700; }
    .filter-chip:hover, .filter-chip.is-active { color: var(--white); background: var(--blue-800); border-color: var(--blue-800); }
    .catalog-status { min-height: 21px; margin: 0 0 16px; color: var(--muted); font-size: 13px; }
    .product-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
    .product-card { min-width: 0; display: flex; flex-direction: column; background: var(--white); border: 1px solid rgba(23,34,45,.08); transition: transform .23s ease, box-shadow .23s ease; }
    .product-card:hover { transform: translateY(-5px); box-shadow: var(--shadow); }
    .product-art { height: 180px; position: relative; display: grid; place-items: center; overflow: hidden; color: var(--blue-900); background: #dfe6ea; }
    .product-art::before { content: ""; position: absolute; inset: 0; opacity: .3; background-image: linear-gradient(135deg, transparent 0 47%, rgba(255,255,255,.55) 48% 49%, transparent 50% 100%); background-size: 26px 26px; }
    .product-art--red { color: var(--red-700); background: #f0dfe0; }
    .product-art--yellow { color: #765919; background: #f2e7bb; }
    .product-art--blue { color: var(--blue-800); background: #dce8f1; }
    .product-art--sand { color: #6b4e32; background: #e8ddd2; }
    .product-art svg { width: 84px; height: 84px; position: relative; z-index: 1; }
    .product-art__tag { position: absolute; z-index: 2; left: 12px; top: 12px; padding: 5px 7px; color: var(--blue-950); background: var(--yellow-500); font-size: 9px; font-weight: 800; text-transform: uppercase; }
    .product-card__body { flex: 1; padding: 17px 15px 15px; display: flex; flex-direction: column; }
    .product-card__category { margin: 0 0 7px; color: var(--red-600); font-size: 10px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
    .product-card h3 { min-height: 45px; margin: 0; color: var(--blue-900); font: 700 18px/1.15 var(--display); letter-spacing: -.035em; }
    .product-card p { margin: 10px 0 0; color: var(--muted); font-size: 12px; line-height: 1.48; }
    .product-card details { margin-top: 12px; padding-top: 11px; border-top: 1px solid var(--line); color: var(--blue-800); font-size: 11px; }
    .product-card summary { cursor: pointer; font-weight: 700; }
    .product-card details p { margin: 7px 0 0; font-size: 11px; }
    .product-card__footer { margin-top: auto; padding-top: 16px; display: flex; align-items: end; justify-content: space-between; gap: 10px; }
    .product-card__note { max-width: 130px; color: var(--muted); font-size: 10px; line-height: 1.25; }
    .query-button { min-height: 34px; padding: 8px 9px; color: var(--white); background: var(--red-600); font-size: 10px; font-weight: 800; white-space: nowrap; }
    .query-button:hover, .query-button.is-added { background: var(--blue-800); }
    .no-results { padding: 60px 20px; color: var(--muted); background: var(--white); text-align: center; }
    .no-results strong { display: block; margin-bottom: 8px; color: var(--blue-900); font: 700 21px var(--display); }
    .catalog-footnote { margin-top: 26px; color: var(--muted); font-size: 12px; }
    .catalog-footnote strong { color: var(--blue-900); }

    .story { background: var(--white); }
    .story-grid { display: grid; grid-template-columns: .9fr 1fr; align-items: center; gap: 11%; }
    .story-art { min-height: 480px; position: relative; padding: 35px; display: grid; place-items: center; overflow: hidden; color: var(--yellow-300); background: var(--blue-900); }
    .story-art::before { content: ""; position: absolute; inset: 24px; border: 1px solid rgba(235,209,123,.42); }
    .story-art::after { content: ""; width: 210px; height: 210px; position: absolute; right: -55px; bottom: -85px; border: 1px solid rgba(235,209,123,.35); border-radius: 50%; box-shadow: 0 0 0 38px rgba(235,209,123,.08), 0 0 0 76px rgba(235,209,123,.04); }
    .story-art svg { width: 90%; height: 90%; position: relative; z-index: 1; }
    .story-art__label { position: absolute; z-index: 2; left: 34px; top: 34px; color: rgba(255,253,249,.7); font-size: 10px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
    .story-art__year { position: absolute; z-index: 2; right: 32px; bottom: 28px; color: var(--yellow-300); font: 800 34px/.9 var(--display); letter-spacing: -.08em; }
    .story-copy h2 { margin: 0 0 25px; color: var(--blue-900); font: 800 clamp(39px, 5vw, 64px)/.98 var(--display); letter-spacing: -.065em; }
    .story-copy h2 em { color: var(--red-600); font-style: normal; }
    .story-copy > p:not(.eyebrow) { max-width: 570px; margin: 0 0 17px; color: var(--muted); font-size: 15px; line-height: 1.75; }
    .fact-grid { margin: 30px 0 31px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 11px; }
    .fact { padding: 15px; border-top: 2px solid var(--red-600); background: var(--paper); }
    .fact strong { display: block; color: var(--blue-900); font: 700 25px var(--display); letter-spacing: -.05em; }
    .fact span { display: block; margin-top: 3px; color: var(--muted); font-size: 11px; line-height: 1.3; }

    .principles { background: var(--paper); }
    .principles-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 13px; }
    .principle { min-height: 245px; padding: 24px; position: relative; background: var(--white); border-top: 3px solid var(--blue-800); }
    .principle:nth-child(2) { border-top-color: var(--red-600); }
    .principle:nth-child(3) { border-top-color: var(--yellow-500); }
    .principle__number { color: var(--red-600); font-size: 11px; font-weight: 800; letter-spacing: .12em; }
    .principle__icon { width: 42px; height: 42px; margin: 31px 0 16px; display: grid; place-items: center; color: var(--blue-800); border: 1px solid var(--line); border-radius: 50%; }
    .principle h3 { margin: 0 0 9px; color: var(--blue-900); font: 700 23px var(--display); letter-spacing: -.04em; }
    .principle p { max-width: 270px; margin: 0; color: var(--muted); font-size: 13px; line-height: 1.6; }

    .contact { position: relative; overflow: hidden; color: var(--white); background: var(--blue-900); }
    .contact::after { content: ""; width: 600px; height: 600px; position: absolute; right: -250px; top: -280px; border: 1px solid rgba(235,209,123,.18); border-radius: 50%; box-shadow: 0 0 0 70px rgba(235,209,123,.04), 0 0 0 140px rgba(235,209,123,.025); }
    .contact-grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1.05fr .95fr; gap: 10%; align-items: start; }
    .contact h2 { max-width: 680px; margin: 0; font: 800 clamp(45px, 6vw, 78px)/.94 var(--display); letter-spacing: -.075em; }
    .contact h2 em { color: var(--yellow-300); font-style: normal; }
    .contact-lead { max-width: 510px; margin: 24px 0 28px; color: rgba(255,253,249,.73); font-size: 16px; line-height: 1.7; }
    .contact-actions { display: flex; flex-wrap: wrap; gap: 12px; }
    .contact-data { display: grid; gap: 10px; }
    .contact-card { padding: 18px; background: rgba(255,253,249,.075); border: 1px solid rgba(255,253,249,.16); }
    .contact-card__label { display: block; margin-bottom: 5px; color: var(--yellow-300); font-size: 10px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
    .contact-card__value { color: var(--white); font-size: 15px; }
    .contact-card__hint { display: block; margin-top: 5px; color: rgba(255,253,249,.5); font-size: 11px; }
    .faq { margin-top: 45px; padding-top: 32px; border-top: 1px solid rgba(255,253,249,.18); }
    .faq h3 { margin: 0 0 12px; color: var(--yellow-300); font: 700 20px var(--display); }
    .faq details { padding: 14px 0; border-bottom: 1px solid rgba(255,253,249,.16); }
    .faq summary { cursor: pointer; color: var(--white); font-size: 14px; font-weight: 700; }
    .faq p { max-width: 680px; margin: 9px 0 0; color: rgba(255,253,249,.65); font-size: 13px; line-height: 1.6; }

    .site-footer { padding: 42px 0 28px; color: var(--white); background: var(--blue-950); }
    .footer-top { display: flex; align-items: center; gap: 25px; padding-bottom: 30px; border-bottom: 1px solid rgba(255,253,249,.16); }
    .footer-top .brand svg { width: 157px; }
    .footer-top .ct-logo__text { fill: var(--white); }
    .footer-top .ct-logo__wall, .footer-top .ct-logo__base { stroke: var(--white); }
    .footer-top .ct-logo__since { fill: rgba(255,253,249,.65); }
    .footer-note { margin-left: auto; color: rgba(255,253,249,.64); font-size: 12px; text-align: right; }
    .footer-note strong { color: var(--yellow-300); }
    .footer-grid { padding-top: 30px; display: grid; grid-template-columns: repeat(3, 1fr) 1.5fr; gap: 28px; }
    .footer-grid h3 { margin: 0 0 12px; color: var(--yellow-300); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; }
    .footer-grid a, .footer-grid span { display: block; margin-bottom: 8px; color: rgba(255,253,249,.7); font-size: 13px; }
    .footer-grid a:hover { color: var(--yellow-300); }
    .footer-slogan { padding-left: 22px; border-left: 1px solid rgba(255,253,249,.16); text-align: right; }
    .footer-slogan strong { color: var(--white); font: 700 28px/1 var(--display); letter-spacing: -.05em; }
    .footer-slogan em { color: var(--yellow-300); font-style: normal; }
    .footer-bottom { margin-top: 34px; color: rgba(255,253,249,.42); font-size: 11px; }

    .query-tray { position: fixed; z-index: 35; left: 50%; bottom: 20px; width: min(680px, calc(100% - 32px)); padding: 13px 15px; display: flex; align-items: center; gap: 14px; color: var(--white); background: var(--blue-950); border: 1px solid rgba(235,209,123,.55); box-shadow: 0 14px 35px rgba(16,41,67,.28); transform: translate(-50%, calc(100% + 35px)); transition: transform .35s cubic-bezier(.2,.7,.2,1); }
    .query-tray.is-visible { transform: translate(-50%, 0); }
    .query-tray__copy { min-width: 0; flex: 1; }
    .query-tray__copy strong { display: block; color: var(--yellow-300); font: 700 16px var(--display); }
    .query-tray__copy span { display: block; overflow: hidden; color: rgba(255,253,249,.65); font-size: 11px; text-overflow: ellipsis; white-space: nowrap; }
    .query-tray__actions { display: flex; flex-shrink: 0; gap: 7px; }
    .query-tray__actions button { min-height: 37px; padding: 8px 11px; font-size: 10px; font-weight: 800; }
    .query-tray__clear { color: var(--white); background: transparent; border: 1px solid rgba(255,253,249,.3); }
    .query-tray__send { color: var(--blue-950); background: var(--yellow-500); }
    .query-tray__send:hover { background: var(--yellow-300); }
    .toast { position: fixed; z-index: 60; right: 22px; bottom: 22px; max-width: min(390px, calc(100% - 44px)); padding: 13px 16px; display: flex; align-items: center; gap: 10px; color: var(--white); background: var(--blue-950); border-left: 3px solid var(--yellow-500); box-shadow: var(--shadow); transform: translateY(140%); transition: transform .3s ease; }
    .toast.is-visible { transform: translateY(0); }
    .toast strong { color: var(--yellow-300); font-size: 18px; }
    .toast p { margin: 0; font-size: 12px; }
    .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
    .reveal { opacity: 0; transform: translateY(20px); transition: opacity .7s ease, transform .7s cubic-bezier(.2,.7,.2,1); }
    .reveal.is-visible { opacity: 1; transform: none; }

    @media (max-width: 1040px) {
      .shell { width: min(100% - 42px, 760px); }
      .desktop-nav { gap: 18px; }
      .nav-whatsapp { padding-inline: 10px; }
      .hero-grid { gap: 5%; }
      .hero-copy h1 { font-size: clamp(50px, 7vw, 76px); }
      .hero-art-wrap { min-height: 460px; }
      .category-grid, .product-grid { grid-template-columns: repeat(2, 1fr); }
      .category-card { min-height: 205px; }
      .product-art { height: 220px; }
    }

    @media (max-width: 720px) {
      .shell { width: calc(100% - 36px); }
      .section { padding: 76px 0; }
      .notice-bar { min-height: 34px; padding-inline: 40px; font-size: 10px; }
      .notice-bar button { right: 8px; }
      .nav-wrap { min-height: 72px; }
      .brand svg { width: 145px; }
      .desktop-nav, .header-search { display: none; }
      .nav-actions { margin-left: auto; }
      .nav-whatsapp { display: none; }
      .menu-toggle { display: block; }
      .mobile-menu { max-height: 0; display: flex; flex-direction: column; overflow: hidden; background: var(--paper); transition: max-height .3s ease; }
      .mobile-menu.is-open { max-height: 365px; padding: 9px 18px 21px; border-top: 1px solid var(--line); }
      .mobile-menu a { padding: 13px 0; display: flex; justify-content: space-between; color: var(--blue-900); border-bottom: 1px solid var(--line); font: 700 20px var(--display); }
      .mobile-menu a::after { content: "↗"; color: var(--red-600); font: 18px var(--sans); }
      .mobile-menu .mobile-contact { margin-top: 18px; }
      .hero { padding: 68px 0 53px; }
      .hero::before { width: 420px; height: 420px; right: -230px; top: -160px; }
      .hero-grid { display: flex; flex-direction: column; align-items: stretch; gap: 48px; }
      .hero-copy h1 { font-size: clamp(49px, 14vw, 78px); }
      .hero-lead { margin-top: 21px; font-size: 15px; }
      .hero-actions { align-items: flex-start; flex-direction: column; }
      .hero-search { margin-top: 31px; }
      .hero-search button { padding-inline: 12px; }
      .hero-art-wrap { order: -1; min-height: 0; }
      .hero-art { width: 100%; padding: 56px 12px 16px; box-shadow: 14px 18px 0 rgba(16,41,67,.42); }
      .hero-art__foot { margin-top: 20px; padding: 0 6px; }
      .hero-art__caption { max-width: 150px; font-size: 11px; }
      .hero-art__badge { width: 91px; height: 91px; padding: 15px 8px; }
      .hero-art__badge strong { font-size: 27px; }
      .hero-art__badge span { margin-top: 5px; font-size: 8px; }
      .casita__cta { width: 100%; max-width: 330px; margin-top: 18px; }
      .trust-grid { padding: 28px 0; grid-template-columns: 1fr 1fr; gap: 22px 13px; }
      .trust-item { padding-left: 0; border-left: 0; }
      .trust-item strong { font-size: 12px; }
      .trust-quote { grid-column: 1 / -1; padding: 17px 0 0; border-top: 1px solid rgba(255,253,249,.28); font-size: 18px; }
      .section-heading { display: block; margin-bottom: 35px; }
      .section-heading__copy { margin-top: 20px; font-size: 14px; }
      .section-heading h2 { font-size: 45px; }
      .category-grid { grid-template-columns: repeat(2, 1fr); gap: 9px; }
      .category-card { min-height: 185px; padding: 16px; }
      .category-card h3 { max-width: 145px; font-size: 20px; }
      .category-card p { font-size: 10px; }
      .category-card__icon { width: 35px; height: 35px; }
      .category-card__icon .icon { width: 18px; height: 18px; }
      .category-card__link { right: 13px; bottom: 13px; }
      .catalog-toolbar { padding: 10px; }
      .catalog-search { min-width: 100%; }
      .filter-list { flex-wrap: nowrap; max-width: 100%; overflow-x: auto; padding-bottom: 2px; }
      .filter-chip { flex-shrink: 0; }
      .product-grid { grid-template-columns: 1fr 1fr; gap: 9px; }
      .product-art { height: 160px; }
      .product-art svg { width: 64px; height: 64px; }
      .product-card__body { padding: 13px 10px 11px; }
      .product-card__category { font-size: 8px; }
      .product-card h3 { min-height: 46px; font-size: 15px; }
      .product-card p { font-size: 11px; }
      .product-card details { font-size: 10px; }
      .product-card__footer { display: block; }
      .product-card__note { max-width: none; margin-bottom: 10px; }
      .query-button { width: 100%; }
      .story-grid, .contact-grid { display: flex; flex-direction: column; gap: 44px; }
      .story-art { width: 100%; min-height: 340px; }
      .story-art__year { font-size: 28px; }
      .story-copy h2 { font-size: 45px; }
      .fact-grid { gap: 8px; }
      .fact { padding: 12px; }
      .fact strong { font-size: 21px; }
      .principles-grid { grid-template-columns: 1fr; gap: 10px; }
      .principle { min-height: 205px; }
      .contact h2 { font-size: 52px; }
      .contact-data { width: 100%; }
      .footer-top { align-items: flex-start; flex-wrap: wrap; }
      .footer-note { width: 100%; margin-left: 0; text-align: left; }
      .footer-grid { grid-template-columns: 1fr 1fr; gap: 25px 17px; }
      .footer-slogan { grid-column: 1 / -1; padding: 22px 0 0; border-top: 1px solid rgba(255,253,249,.16); border-left: 0; text-align: left; }
      .query-tray { bottom: 10px; gap: 9px; }
      .query-tray__actions { flex-direction: column; }
      .query-tray__actions button { min-height: 32px; }
      .toast { right: 14px; bottom: 14px; max-width: calc(100% - 28px); }
    }

    @media (max-width: 390px) {
      .shell { width: calc(100% - 28px); }
      .category-card { min-height: 172px; padding: 13px; }
      .category-card h3 { font-size: 18px; }
      .product-grid { gap: 7px; }
      .product-art { height: 145px; }
      .product-card h3 { font-size: 14px; }
      .contact h2 { font-size: 46px; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; }
      .reveal { opacity: 1; transform: none; }
    }
  </style>
</head>
<body>
  <div class="notice-bar" id="notice-bar">
    <span><strong>Casa Tito</strong> · más de 73 años acompañando proyectos con criterio y cercanía.</span>
    <button type="button" id="notice-close" aria-label="Cerrar aviso">×</button>
  </div>

  <header class="site-header" id="inicio">
    <div class="shell nav-wrap">
      <a class="brand" href="#inicio" aria-label="Casa Tito, volver al inicio">
        <svg viewBox="0 0 220 84" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
          <path class="ct-logo__roof-shadow" d="M3 40 L110 6 L217 40"/>
          <path class="ct-logo__roof" d="M3 40 L110 6 L217 40"/>
          <path class="ct-logo__wall" d="M17 36 V76 M203 36 V76"/>
          <path class="ct-logo__base" d="M17 76 H56 M203 76 H164"/>
          <text class="ct-logo__since" x="110.5" y="81" text-anchor="middle">Desde 1953</text>
          <text class="ct-logo__text" x="110" y="63" text-anchor="middle"><tspan>CASA </tspan><tspan class="ct-logo__accent">TITO</tspan></text>
        </svg>
      </a>
      <nav class="desktop-nav" aria-label="Navegación principal">
        <a href="#categorias">Categorías</a>
        <a href="#catalogo">Catálogo</a>
        <a href="#casa-tito">Nuestra casa</a>
        <a href="#contacto">Contacto</a>
      </nav>
      <div class="nav-actions">
        <button class="header-search" type="button" id="header-search" aria-label="Buscar productos">
          <svg class="icon" aria-hidden="true"><use href="#i-search"/></svg>
        </button>
        <button class="button nav-whatsapp" type="button" data-whatsapp>Consultar por WhatsApp</button>
        <button class="menu-toggle" type="button" id="menu-toggle" aria-label="Abrir menú" aria-expanded="false"><span></span><span></span><span></span></button>
      </div>
    </div>
    <nav class="mobile-menu" id="mobile-menu" aria-label="Navegación móvil" aria-hidden="true">
      <a href="#categorias">Categorías</a>
      <a href="#catalogo">Catálogo</a>
      <a href="#casa-tito">Nuestra casa</a>
      <a href="#contacto">Contacto</a>
      <button class="button button--red mobile-contact" type="button" data-whatsapp>Consultar por WhatsApp</button>
    </nav>
  </header>

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="shell hero-grid">
        <div class="hero-copy reveal">
          <p class="eyebrow eyebrow--light">Ferretería · hogar · obra</p>
          <h1 id="hero-title">Todo empieza con una <em>buena elección.</em></h1>
          <p class="hero-lead">Más de 73 años entendiendo lo que hace falta para reparar, mantener y llevar adelante cada proyecto.</p>
          <div class="hero-actions">
            <button class="button button--ghost-light" type="button" data-whatsapp>Consultar por WhatsApp</button>
          </div>
          <p class="hero-note"><strong>Información clara.</strong> Precios, marcas y disponibilidad se confirman en cada consulta.</p>
          <form class="hero-search" id="hero-search-form" role="search">
            <svg class="icon" aria-hidden="true"><use href="#i-search"/></svg>
            <label class="sr-only" for="hero-search">¿Qué estás buscando?</label>
            <input id="hero-search" type="search" placeholder="¿Qué necesitás resolver?" autocomplete="off">
            <button type="submit">Buscar</button>
          </form>
        </div>
        <div class="hero-art-wrap">
          <div class="hero-art" role="group" aria-label="La casita de Casa Tito: una invitación a explorar los productos">
            <span class="hero-art__label">El oficio de elegir bien</span>
            <div class="hero-art__stage">
              <div class="casita" id="casita" aria-hidden="true">
                <svg class="casita__svg" viewBox="0 0 400 270" focusable="false" xmlns="http://www.w3.org/2000/svg">
                  <ellipse class="ct-h-ground" cx="200" cy="252" rx="190" ry="5"/>
                  <path class="ct-h-roof-shadow c-draw" pathLength="1" d="M6 108 L200 24 L394 108"/>
                  <path class="ct-h-roof c-draw" pathLength="1" d="M6 108 L200 24 L394 108"/>
                  <path class="ct-h-wall c-draw" pathLength="1" d="M24 100 V244"/>
                  <path class="ct-h-wall c-draw" pathLength="1" d="M376 100 V244"/>
                  <path class="ct-h-base c-draw" pathLength="1" d="M24 244 H112"/>
                  <path class="ct-h-base c-draw" pathLength="1" d="M376 244 H288"/>
                  <path class="ct-h-sill c-draw" pathLength="1" d="M104 235 H296"/>
                </svg>
                <div class="casita__glow"></div>
                <div class="casita__window">
                  <div class="casita__reveal">
                    <svg class="casita__interior" viewBox="0 0 176 108" preserveAspectRatio="xMidYMid slice" focusable="false" xmlns="http://www.w3.org/2000/svg">
                      <defs>
                        <linearGradient id="ct-wallg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f7e8b6"/><stop offset="1" stop-color="#e8cf86"/></linearGradient>
                        <radialGradient id="ct-lampg" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#fff6cf" stop-opacity=".95"/><stop offset="1" stop-color="#fff6cf" stop-opacity="0"/></radialGradient>
                        <radialGradient id="ct-vig" cx=".5" cy=".5" r=".75"><stop offset=".55" stop-color="#102943" stop-opacity="0"/><stop offset="1" stop-color="#102943" stop-opacity=".5"/></radialGradient>
                      </defs>
                      <rect width="176" height="108" fill="#c79b44"/>
                      <polygon points="0,0 176,0 136,22 40,22" fill="#8a6428"/>
                      <polygon points="0,108 176,108 136,74 40,74" fill="#b8893a"/>
                      <polygon points="0,0 40,22 40,74 0,108" fill="#d1aa58"/>
                      <polygon points="176,0 136,22 136,74 176,108" fill="#bf9747"/>
                      <rect x="40" y="22" width="96" height="52" fill="url(#ct-wallg)"/>
                      <g stroke="#3b2d1f" stroke-opacity=".12" stroke-width=".7"><path d="M64 74 L44 108M112 74 L132 108M88 74 V108"/></g>
                      <rect x="44" y="45" width="88" height="2" fill="#6b4e32"/>
                      <rect x="44" y="63" width="88" height="2" fill="#6b4e32"/>
                      <rect x="48" y="35" width="9" height="10" fill="#b52b32"/><rect x="48" y="35" width="9" height="2" fill="#7e1d23"/>
