  <script>
    /* Casita de Casa Tito: abre la ventana una sola vez por sesión (o al instante si el usuario reduce animaciones). */
    (function () {
      var stage = document.getElementById("casita");
      if (!stage) return;
      var KEY = "casatito-casita-v1", started = false, reduce = false, seen = false;
      try { reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches; } catch (e) {}
      try { seen = window.sessionStorage.getItem(KEY) === "1"; } catch (e) {}

      function showNow() { if (started) return; started = true; stage.classList.add("is-instant", "is-open"); }
      function play() {
        if (started) return;
        started = true;
        void stage.offsetWidth;
        stage.classList.add("is-open");
        try { window.sessionStorage.setItem(KEY, "1"); } catch (e) {}
      }

      if (reduce || seen) {
        showNow();
      } else if ("IntersectionObserver" in window) {
        var io = new IntersectionObserver(function (entries) {
          if (entries.some(function (entry) { return entry.isIntersecting; })) { io.disconnect(); setTimeout(play, 280); }
        }, { threshold: 0.35 });
        io.observe(stage);
      } else {
        setTimeout(play, 280);
      }

      /* Tocar la casita o la ventana lleva al catálogo, igual que el botón. */
      stage.addEventListener("click", function () {
        var target = document.getElementById("catalogo");
        if (target) target.scrollIntoView({ behavior: reduce ? "auto" : "smooth" });
      });
    })();
  </script>
  <script>
    /*
      CONFIGURACIÓN RÁPIDA
      Completá solamente estos datos cuando los tengas confirmados.
      El número de WhatsApp debe incluir código de país y ciudad, sin +, espacios ni guiones.
      Ejemplo de formato: 549351XXXXXXXX (reemplazá las X por el número real).
    */
    const SITE_CONFIG = {
      whatsapp: "",
      whatsappLabel: "Número a confirmar",
      hours: "Información a completar"
    };

    const categories = [
      { id: "pinturas", name: "Pinturas y látex", short: "Color, protección y terminaciones.", icon: "paint" },
      { id: "membranas", name: "Membranas", short: "Soluciones para cuidar superficies.", icon: "roof" },
      { id: "fijaciones", name: "Tornillería y fijaciones", short: "Uniones para cada trabajo.", icon: "bolt" },
      { id: "manuales", name: "Herramientas manuales", short: "Precisión para todos los días.", icon: "hammer" },
      { id: "electricas", name: "Herramientas eléctricas", short: "Potencia para avanzar mejor.", icon: "drill" },
      { id: "construccion", name: "Construcción", short: "Materiales para hacer base.", icon: "bricks" },
      { id: "hogar", name: "Hogar", short: "Soluciones prácticas para tu casa.", icon: "home" },
      { id: "mantenimiento", name: "Mantenimiento", short: "Reparar, cuidar y prolongar.", icon: "wrench" }
    ];

    /* Lista editable: son referencias de catálogo, no promesas de stock ni precios. */
    const products = [
      { id: "latex-interior", name: "Látex para interior", category: "pinturas", description: "Para renovar ambientes y superficies interiores.", detail: "Consultá colores, terminación, rendimiento y marcas disponibles.", tag: "Pinturas", art: "red", icon: "paint" },
      { id: "membrana-liquida", name: "Membrana líquida", category: "membranas", description: "Una referencia para trabajos de protección y reparación.", detail: "Consultá tipo de superficie, presentación y aplicación recomendada.", tag: "Protección", art: "yellow", icon: "roof" },
      { id: "tornillos", name: "Tornillos y fijaciones", category: "fijaciones", description: "Opciones para madera, metal y usos generales.", detail: "Consultá medida, material, cabeza, cantidad y accesorio adecuado.", tag: "Fijaciones", art: "blue", icon: "bolt" },
      { id: "tarugos", name: "Tarugos y anclajes", category: "fijaciones", description: "Para elegir una sujeción acorde a cada superficie.", detail: "Consultá diámetro, tipo de pared y carga de trabajo.", tag: "Fijaciones", art: "sand", icon: "bolt" },
      { id: "llaves", name: "Juego de llaves combinadas", category: "manuales", description: "Herramientas de mano para mantenimiento y taller.", detail: "Consultá medidas, cantidad de piezas y marcas disponibles.", tag: "Herramientas", art: "blue", icon: "wrench" },
      { id: "martillo", name: "Martillo de uña", category: "manuales", description: "Una herramienta esencial para tareas de reparación.", detail: "Consultá peso, mango y opciones disponibles.", tag: "Herramientas", art: "red", icon: "hammer" },
      { id: "taladro", name: "Taladro percutor", category: "electricas", description: "Potencia para perforar y avanzar en distintos trabajos.", detail: "Consultá potencia, accesorios, tensión y garantía.", tag: "Eléctricas", art: "yellow", icon: "drill" },
      { id: "amoladora", name: "Amoladora angular", category: "electricas", description: "Para corte, desbaste y tareas de obra o taller.", detail: "Consultá diámetro de disco, potencia y accesorios.", tag: "Eléctricas", art: "sand", icon: "drill" },
      { id: "cemento", name: "Materiales para obra", category: "construccion", description: "Referencias para reparación, obra y mantenimiento.", detail: "Consultá disponibilidad, presentación y uso recomendado.", tag: "Construcción", art: "sand", icon: "bricks" },
      { id: "organizacion", name: "Organización para el hogar", category: "hogar", description: "Soluciones prácticas para ordenar y resolver.", detail: "Consultá medidas, materiales y alternativas.", tag: "Hogar", art: "blue", icon: "home" },
      { id: "sellador", name: "Selladores y adhesivos", category: "mantenimiento", description: "Para reparar, fijar y mantener superficies.", detail: "Consultá compatibilidad, aplicación y tiempo de secado.", tag: "Mantenimiento", art: "red", icon: "wrench" },
      { id: "lubricante", name: "Lubricación y cuidado", category: "mantenimiento", description: "Ayudas para prolongar la vida útil de herramientas y piezas.", detail: "Consultá uso, formato y superficie compatible.", tag: "Mantenimiento", art: "yellow", icon: "wrench" }
    ];

    const iconPaths = {
      paint: '<path d="M5 17h10M7 14l8-8 3 3-8 8H7zM16 5l2-2 3 3-2 2M5 20h14"/>',
      roof: '<path d="M3 12 12 4l9 8M5 11v9h14v-9M9 20v-5h6v5"/>',
      bolt: '<path d="M13 2 5 13h6l-1 9 8-12h-6z"/>',
      hammer: '<path d="m4 7 10-4 3 3-4 4M13 10l7 7-3 3-7-7M5 19l5-5"/>',
      drill: '<path d="M4 8h9l4 3v4H9l-5-3zM17 11h3v4h-3M8 15v5M12 15v5M4 8V5h7l2 3"/>',
      bricks: '<path d="M4 5h7v5H4zM13 5h7v5h-7zM4 12h7v5H4zM13 12h7v5h-7zM7 19h10v2H7z"/>',
      home: '<path d="m3 11 9-8 9 8M5 10v10h14V10M9 20v-6h6v6"/>',
      wrench: '<path d="M14 6a5 5 0 0 0-6 6l-5 5a2 2 0 0 0 3 3l5-5a5 5 0 0 0 6-6l-3 3-3-3z"/>'
    };

    const $ = (selector, root = document) => root.querySelector(selector);
    const $$ = (selector, root = document) => [...root.querySelectorAll(selector)];
    const plain = value => String(value).normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
    const icon = name => `<svg class="icon" aria-hidden="true" viewBox="0 0 24 24">${iconPaths[name] || iconPaths.wrench}</svg>`;
    const categoryMap = Object.fromEntries(categories.map(category => [category.id, category]));
    let activeCategory = "all";
    let queryItems = [];
    let toastTimer;

    function showToast(message) {
      const toast = $("#toast");
      $("p", toast).textContent = message;
      toast.classList.add("is-visible");
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toast.classList.remove("is-visible"), 4200);
    }

    function renderCategories() {
      $("#category-grid").innerHTML = categories.map((category, index) => `
        <button class="category-card reveal" type="button" data-category="${category.id}" aria-label="Filtrar por ${category.name}">
          <span class="category-card__top"><span class="category-card__number">0${index + 1}</span><span class="category-card__icon">${icon(category.icon)}</span></span>
          <span><h3>${category.name}</h3><p>${category.short}</p></span>
          <span class="category-card__link" aria-hidden="true">↗</span>
        </button>
      `).join("");
      $$(".category-card").forEach(card => card.addEventListener("click", () => {
        setCategory(card.dataset.category);
        $("#catalogo").scrollIntoView({ behavior: prefersReducedMotion() ? "auto" : "smooth" });
      }));
      observeReveals($("#category-grid"));
    }

    function renderFilters() {
      $("#filter-list").innerHTML = [{ id: "all", name: "Todo el catálogo" }, ...categories].map(category => `
        <button class="filter-chip${category.id === "all" ? " is-active" : ""}" type="button" data-filter="${category.id}">${category.name}</button>
      `).join("");
      $$(".filter-chip").forEach(button => button.addEventListener("click", () => setCategory(button.dataset.filter)));
    }

    function productMatches(product, query) {
      const category = categoryMap[product.category];
      const haystack = plain(`${product.name} ${product.description} ${product.tag} ${category.name}`);
      return !query || haystack.includes(plain(query));
    }

    function renderProducts() {
      const query = $("#catalog-search").value.trim();
      const visibleProducts = products.filter(product => (activeCategory === "all" || product.category === activeCategory) && productMatches(product, query));
      $("#catalog-status").textContent = `${visibleProducts.length} ${visibleProducts.length === 1 ? "referencia disponible" : "referencias disponibles"}`;
      $("#no-results").hidden = visibleProducts.length > 0;
      $("#product-grid").innerHTML = visibleProducts.map(product => `
        <article class="product-card reveal">
          <div class="product-art product-art--${product.art}"><span class="product-art__tag">${product.tag}</span>${icon(product.icon)}</div>
          <div class="product-card__body">
            <p class="product-card__category">${categoryMap[product.category].name}</p>
            <h3>${product.name}</h3>
            <p>${product.description}</p>
            <details><summary>¿Para qué sirve?</summary><p>${product.detail}</p></details>
            <div class="product-card__footer"><span class="product-card__note">Precio y stock a confirmar</span><button class="query-button${queryItems.includes(product.id) ? " is-added" : ""}" type="button" data-query="${product.id}">${queryItems.includes(product.id) ? "Agregado" : "Sumar a mi consulta"}</button></div>
          </div>
        </article>
      `).join("");
      $$("[data-query]", $("#product-grid")).forEach(button => button.addEventListener("click", () => toggleQuery(button.dataset.query)));
      observeReveals($("#product-grid"));
    }

    function setCategory(category) {
      activeCategory = category;
      $$(".filter-chip").forEach(button => button.classList.toggle("is-active", button.dataset.filter === category));
      renderProducts();
    }

    function toggleQuery(productId) {
      const product = products.find(item => item.id === productId);
      if (!product) return;
      if (queryItems.includes(productId)) {
        queryItems = queryItems.filter(id => id !== productId);
        showToast(`${product.name} salió de tu consulta.`);
      } else {
        queryItems.push(productId);
        showToast(`${product.name} se sumó a tu consulta.`);
      }
      renderProducts();
      renderQueryTray();
    }

    function renderQueryTray() {
      const tray = $("#query-tray");
      const selected = queryItems.map(id => products.find(product => product.id === id)).filter(Boolean);
      const count = selected.length;
      tray.classList.toggle("is-visible", count > 0);
      tray.setAttribute("aria-hidden", String(count === 0));
      $("#query-count").textContent = `${count} ${count === 1 ? "producto" : "productos"}`;
      $("#query-summary").textContent = count ? selected.map(product => product.name).join(" · ") : "Todavía no agregaste productos a tu consulta.";
    }

    function whatsappUrl() {
      const number = String(SITE_CONFIG.whatsapp || "").replace(/\D/g, "");
      return number ? `https://wa.me/${number}` : "";
    }

    function sendWhatsApp(message = "Hola, quiero hacer una consulta sobre productos de Casa Tito.") {
      const url = whatsappUrl();
      if (!url) {
        showToast("El botón está listo. Falta completar el número real de WhatsApp en SITE_CONFIG.");
        $("#contacto").scrollIntoView({ behavior: prefersReducedMotion() ? "auto" : "smooth" });
        return;
      }
      window.open(`${url}?text=${encodeURIComponent(message)}`, "_blank", "noopener,noreferrer");
    }

    function sendQuery() {
      const selected = queryItems.map(id => products.find(product => product.id === id)).filter(Boolean);
      if (!selected.length) return;
      const lines = selected.map((product, index) => `${index + 1}. ${product.name} — ${categoryMap[product.category].name}`);
      sendWhatsApp(`Hola, Casa Tito. Quiero consultar por estos productos:\n\n${lines.join("\n")}\n\n¿Podrían indicarme precio, marca y disponibilidad?`);
    }

    function prefersReducedMotion() { return window.matchMedia("(prefers-reduced-motion: reduce)").matches; }

    function setMenu(open) {
      const toggle = $("#menu-toggle");
      const menu = $("#mobile-menu");
      toggle.classList.toggle("is-active", open);
      toggle.setAttribute("aria-expanded", String(open));
      menu.classList.toggle("is-open", open);
      menu.setAttribute("aria-hidden", String(!open));
      document.body.classList.toggle("menu-open", open);
    }

    function observeReveals(root = document) {
      const items = $$(".reveal:not(.reveal-ready)", root);
      if (!("IntersectionObserver" in window)) {
        items.forEach(item => item.classList.add("is-visible", "reveal-ready"));
        return;
      }
      items.forEach(item => {
        item.classList.add("reveal-ready");
        revealObserver.observe(item);
      });
    }

    const revealObserver = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: .1 });

    renderCategories();
    renderFilters();
    renderProducts();
    renderQueryTray();
    observeReveals();
    $("#current-year").textContent = new Date().getFullYear();

    $("#catalog-search").addEventListener("input", renderProducts);
    $("#reset-search").addEventListener("click", () => { $("#catalog-search").value = ""; setCategory("all"); });
    $("#hero-search-form").addEventListener("submit", event => {
      event.preventDefault();
      $("#catalog-search").value = $("#hero-search").value;
      setCategory("all");
      $("#catalogo").scrollIntoView({ behavior: prefersReducedMotion() ? "auto" : "smooth" });
      renderProducts();
    });
    $("#header-search").addEventListener("click", () => {
      $("#catalogo").scrollIntoView({ behavior: prefersReducedMotion() ? "auto" : "smooth" });
      setTimeout(() => $("#catalog-search").focus(), prefersReducedMotion() ? 0 : 450);
    });
    $("#clear-query").addEventListener("click", () => { queryItems = []; renderProducts(); renderQueryTray(); });
    $("#send-query").addEventListener("click", sendQuery);
    $("#menu-toggle").addEventListener("click", () => setMenu(!$("#mobile-menu").classList.contains("is-open")));
    $$("#mobile-menu a, #mobile-menu button").forEach(element => element.addEventListener("click", () => setMenu(false)));
    $("#notice-close").addEventListener("click", () => $("#notice-bar").remove());
    $$("[data-whatsapp]").forEach(button => button.addEventListener("click", () => sendWhatsApp()));
    $$('a[href="#inicio"]').forEach(link => link.addEventListener("click", event => { event.preventDefault(); window.scrollTo({ top: 0, behavior: prefersReducedMotion() ? "auto" : "smooth" }); }));
    document.addEventListener("keydown", event => { if (event.key === "Escape") setMenu(false); });
    window.addEventListener("scroll", () => $(".site-header").classList.toggle("is-scrolled", window.scrollY > 10), { passive: true });

    $("#contact-whatsapp").textContent = SITE_CONFIG.whatsappLabel || "Número a confirmar";
  </script>
</body>
</html>
