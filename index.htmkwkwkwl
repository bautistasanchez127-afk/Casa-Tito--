              <path stroke-width="5" d="M113 160l-34-28M387 160l34-28M114 92l29 30M386 92l-29 30"/>
              <path stroke-width="7" d="M198 173l28-30 41 36-28 31zM226 143l13-19 42 34-14 20"/>
