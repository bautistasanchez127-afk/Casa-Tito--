
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Casa Tito | Autoservicio Ferretero</title>

<style>
:root {
  --azul: #102b50;
  --rojo: #e43135;
  --gris: #f4f6f8;
  --blanco: #ffffff;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  background: var(--gris);
  color: var(--azul);
}

header {
  background: white;
  padding: 16px;
  border-bottom: 1px solid #e5e7eb;
}

.nav {
  max-width: 1100px;
  margin: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
}

.logo {
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 900;
  font-size: 27px;
  color: var(--rojo);
}

.logo-icon {
  background: var(--azul);
  color: white;
  border: 4px solid var(--rojo);
  border-radius: 12px;
  padding: 8px;
  font-size: 23px;
}

.logo small {
  display: block;
  font-size: 10px;
  letter-spacing: 1px;
  color: var(--azul);
}

.search {
  flex: 1;
  min-width: 180px;
  max-width: 420px;
}

input {
  width: 100%;
  padding: 13px;
  border: 1px solid #d5dbe3;
  border-radius: 10px;
  font-size: 15px;
}

button {
  cursor: pointer;
  border: none;
  border-radius: 9px;
  padding: 12px 16px;
  font-weight: bold;
  font-size: 14px;
}

.cart-button {
  background: var(--azul);
  color: white;
}

.hero {
  background: linear-gradient(120deg, #102b50, #234b78);
  color: white;
  padding: 55px 20px;
}

.hero-inner {
  max-width: 1100px;
  margin: auto;
}

.hero h1 {
  font-size: clamp(30px, 6vw, 52px);
  max-width: 650px;
  margin: 0 0 16px;
  line-height: 1.1;
}

.hero p {
  font-size: 17px;
  color: #e0e8f2;
  max-width: 550px;
  line-height: 1.6;
}

.hero button {
  background: var(--rojo);
  color: white;
  margin-top: 12px;
}

main {
  max-width: 1100px;
  margin: auto;
  padding: 28px 16px 60px;
}

h2 {
  font-size: 25px;
  margin: 0 0 20px;
}

.categories {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  margin-bottom: 32px;
}

.category {
  background: white;
  color: var(--azul);
  border: 1px solid #dbe1e8;
}

.category.active {
  background: var(--azul);
  color: white;
}

.products {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
}

.product {
  background: white;
  border-radius: 13px;
  overflow: hidden;
  border: 1px solid #e4e8ed;
}

.product-image {
  height: 145px;
  background: #eaf0f6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 55px;
}

.product-info {
  padding: 15px;
}

.product-info small {
  color: #718096;
}

.product-info h3 {
  font-size: 16px;
  min-height: 38px;
  margin: 8px 0;
}

.price {
  font-size: 15px;
  font-weight: bold;
  margin: 12px 0;
}

.add {
  width: 100%;
  background: var(--rojo);
  color: white;
}

.empty {
  padding: 30px;
  text-align: center;
  background: white;
  border-radius: 12px;
}

footer {
  background: var(--azul);
  color: white;
  padding: 30px 18px;
  text-align: center;
}

footer p {
  color: #dce5ef;
}

@media (max-width: 800px) {
  .products {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .product-image {
    height: 120px;
  }
}

@media (max-width: 380px) {
  .logo {
    font-size: 23px;
  }

  .product-info {
    padding: 11px;
  }
}
</style>
</head>

<body>

<header>
  <div class="nav">

    <div class="logo">
      <div class="logo-icon">🔩</div>
      <div>
        Tito
        <small>AUTOSERVICIO FERRETERO</small>
      </div>
    </div>

    <div class="search">
      <input
        id="search"
        type="search"
        placeholder="¿Qué producto estás buscando?"
      >
    </div>

    <button class="cart-button" onclick="sendOrder()">
      🛒 Pedido (<span id="cart-count">0</span>)
    </button>

  </div>
</header>

<section class="hero">
  <div class="hero-inner">
    <h1>Todo para tus proyectos, en un solo lugar.</h1>
    <p>
      Herramientas, materiales y soluciones para tu hogar,
      obra o negocio. La experiencia de Casa Tito desde 1953.
    </p>
    <button onclick="document.getElementById('catalogo').scrollIntoView({behavior:'smooth'})">
      Explorar productos →
    </button>
  </div>
</section>

<main id="catalogo">

  <h2>Encontrá lo que necesitás</h2>

  <div class="categories" id="categories"></div>

  <h2>Productos de nuestra ferretería</h2>

  <div class="products" id="products"></div>

</main>

<footer>
  <h2>Casa Tito</h2>
  <p>Autoservicio Ferretero · Sucesores de Pablo Antonini</p>
  <p>Desde 1953, acompañando tus proyectos.</p>
</footer>

<script>
const WHATSAPP = "549351XXXXXXXX";

// Productos de demostración.
// Reemplazá estos ejemplos por los productos reales.
const products = [
  {
    id: 1,
    name: "Taladro eléctrico",
    category: "Herramientas",
    price: "Consultar precio",
    emoji: "🔧"
  },
  {
    id: 2,
    name: "Juego de destornilladores",
    category: "Herramientas",
    price: "Consultar precio",
    emoji: "🪛"
  },
  {
    id: 3,
    name: "Tornillos y bulones",
    category: "Bulonería",
    price: "Consultar precio",
    emoji: "🔩"
  },
  {
    id: 4,
    name: "Pintura para interiores",
    category: "Pinturas",
    price: "Consultar precio",
    emoji: "🪣"
  },
  {
    id: 5,
    name: "Cinta métrica",
    category: "Herramientas",
    price: "Consultar precio",
    emoji: "📏"
  },
  {
    id: 6,
    name: "Accesorios de plomería",
    category: "Plomería",
    price: "Consultar precio",
    emoji: "🚰"
  },
  {
    id: 7,
    name: "Guantes de trabajo",
    category: "Seguridad",
    price: "Consultar precio",
    emoji: "🧤"
  },
  {
    id: 8,
    name: "Elementos eléctricos",
    category: "Electricidad",
    price: "Consultar precio",
    emoji: "💡"
  }
];

let cart = [];
let selectedCategory = "Todos";

function renderCategories() {
  const categories = [
    "Todos",
    ...new Set(products.map(p => p.category))
  ];

  document.getElementById("categories").innerHTML =
    categories.map(category => `
      <button
        class="category ${selectedCategory === category ? 'active' : ''}"
        onclick="selectCategory('${category}')">
        ${category}
      </button>
    `).join("");
}

function selectCategory(category) {
  selectedCategory = category;
  renderCategories();
  renderProducts();
}

function renderProducts() {
  const search = document
    .getElementById("search")
    .value
    .toLowerCase();

  const filtered = products.filter(product => {
    const matchesSearch =
      product.name.toLowerCase().includes(search) ||
      product.category.toLowerCase().includes(search);

    const matchesCategory =
      selectedCategory === "Todos" ||
      product.category === selectedCategory;

    return matchesSearch && matchesCategory;
  });

  const container = document.getElementById("products");

  if (filtered.length === 0) {
    container.innerHTML = `
      <div class="empty">
        No encontramos productos con esa búsqueda.
      </div>
    `;
    return;
  }

  container.innerHTML = filtered.map(product => `
    <article class="product">
      <div class="product-image">${product.emoji}</div>
      <div class="product-info">
        <small>${product.category}</small>
        <h3>${product.name}</h3>
        <div class="price">${product.price}</div>
        <button class="add" onclick="addToCart(${product.id})">
          Agregar al pedido
        </button>
      </div>
    </article>
  `).join("");
}

function addToCart(id) {
  const product = products.find(p => p.id === id);
  const existing = cart.find(p => p.id === id);

  if (existing) {
    existing.quantity++;
  } else {
    cart.push({...product, quantity: 1});
  }

  document.getElementById("cart-count").textContent =
    cart.reduce((total, p) => total + p.quantity, 0);
}

function sendOrder() {
  if (cart.length === 0) {
    alert("Todavía no agregaste productos al pedido.");
    return;
  }

  if (WHATSAPP.includes("X")) {
    alert("Primero tenemos que configurar el WhatsApp de Casa Tito.");
    return;
  }

  const message = [
    "Hola Casa Tito, quiero consultar por este pedido:",
    "",
    ...cart.map(p => `${p.quantity} x ${p.name}`),
    "",
    "¿Me pasan los precios y la disponibilidad?"
  ].join("\n");

  window.open(
    "https://wa.me/" + WHATSAPP + "?text=" +
    encodeURIComponent(message),
    "_blank"
  );
}

document.getElementById("search").addEventListener(
  "input",
  renderProducts
);

renderCategories();
renderProducts();
</script>

</body>
</html>

